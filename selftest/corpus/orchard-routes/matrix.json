    { "id": "unsupported-path-expression", "config": "orchard.config.json", "start": "/orchard/mystery/shelf", "expect": { "reason": "unsupported-expression" } },
    { "id": "unsupported-route-object", "config": "orchard.config.json", "start": "/orchard/shed/tools", "expect": { "reason": "unsupported-expression" } },
    { "id": "unknown-host-read-from-root", "config": "orchard.config.json", "start": "/partners", "expect": { "entry": "src/partners/PartnerDirectory.tsx#PartnerDirectory" } },
    { "id": "unknown-host-inferred-prefix", "config": "orchard.config.json", "start": "/orchard/partners", "expect": { "entry": "src/partners/PartnerDirectory.tsx#PartnerDirectory" } },
    { "id": "missing-mount", "config": "orchard.config.json", "start": "/portal/partners", "expect": { "reason": "missing-mount" } },
    { "id": "configured-mount", "config": "orchard-mounted.config.json", "start": "/portal/partners", "expect": { "entry": "src/partners/PartnerDirectory.tsx#PartnerDirectory" } },
    { "id": "duplicate-mounts", "config": "orchard.config.json", "start": "/ledger", "expect": { "reason": "ambiguous" } },
