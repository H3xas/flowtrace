    { "id": "descendant-parameter", "config": "orchard.config.json", "start": "/orchard/harvest/crates/c-9", "expect": { "entry": "src/harvest/crates/CrateDetail.tsx#CrateDetail" } },
    { "id": "redirect", "config": "orchard.config.json", "start": "/orchard/old-rows", "expect": { "entry": "src/rows/RowList.tsx#RowList" } },
